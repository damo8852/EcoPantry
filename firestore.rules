rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function isAuthed() { return request.auth != null; }
    function isOwner(uid) { return request.auth.uid == uid; }
    function isNotGuest() {
      return request.auth != null &&
             request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // Security: Validate string lengths to prevent abuse
    function isValidString(str, maxLen) {
      return str is string && str.size() <= maxLen && str.size() > 0;
    }

    // Security: Validate recipe data
    function isValidRecipeData(data) {
      return isValidString(data.name, 200) &&
             isValidString(data.description, 2000) &&
             data.ingredients is list && data.ingredients.size() <= 100 &&
             data.instructions is list && data.instructions.size() <= 100;
    }

    // Allow authenticated users to read config documents
    match /config/{document} {
      allow read: if isAuthed();
    }

    match /users/{uid} {
      allow read, create: if isAuthed() && isOwner(uid);
      allow update, delete: if isAuthed() && isOwner(uid);

      match /items/{itemId} {
        allow read, write: if isAuthed() && isOwner(uid);
      }

      match /finished_items/{itemId} {
        allow read, write: if isAuthed() && isOwner(uid);
      }

      match /saved_recipes/{recipeId} {
        allow read, write: if isAuthed() && isOwner(uid);
      }

      match /connected_stores/{storeId} {
        allow read, write: if isAuthed() && isOwner(uid);
      }

      match /shopping_list/{itemId} {
        allow read, write: if isAuthed() && isOwner(uid);
      }
    }

    // Community recipes - read for all authenticated, create/update for non-guest users
    match /community_recipes/{recipeId} {
      allow read: if isAuthed();
      allow create: if isNotGuest() && isValidRecipeData(request.resource.data);

      // Security: Restrict updates to specific fields only
      allow update: if isAuthed() && (
        // Allow author to update their own recipe
        (resource.data.authorId == request.auth.uid && isValidRecipeData(request.resource.data)) ||
        // Allow incrementing saves counter only
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['saves']) &&
         request.resource.data.saves == resource.data.saves + 1)
      );

      allow delete: if isAuthed() &&
                       (resource.data.authorId == request.auth.uid ||
                        request.auth.token.email_verified == true);

      // Ratings subcollection
      match /ratings/{userId} {
        allow read: if isAuthed();
        allow write: if isNotGuest() && isOwner(userId) &&
                        request.resource.data.rating >= 1 &&
                        request.resource.data.rating <= 5;
      }

      // Comments subcollection
      match /comments/{commentId} {
        allow read: if isAuthed();
        allow create: if isNotGuest() &&
                         isValidString(request.resource.data.text, 1000);
        allow update, delete: if isNotGuest() &&
                                  resource.data.userId == request.auth.uid;
      }
    }
  }
}
