<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Security: Block cleartext (non-HTTPS) traffic by default -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <!-- Trust system certificate authorities -->
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Debug configuration: Allow cleartext traffic for localhost in debug mode only -->
    <debug-overrides cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
